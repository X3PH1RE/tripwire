# Copy to .env.local. Everything is optional: without a token the CVE beat replays instead of opening a real PR.

# Fine-grained token scoped to the throwaway demo repo only (Contents + Pull requests: read/write).
GITHUB_TOKEN=
DEMO_REPO=X3PH1RE/acme-shop-demo
# Shown if the GitHub API fails during the CVE beat.
FALLBACK_PR_URL=

# Real repo scan: commits of history to scan, and the OSV API.
SCAN_HISTORY_COMMITS=300
OSV_API=https://api.osv.dev/v1

# Optional LLM text. Canned text is used when disabled or on any error.
LLM_ENABLED=0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=3000

# Honey secrets (Canarytokens). Where alerts go; one of these is required to create decoys.
HONEY_ALERT_EMAIL=
# HONEY_ALERT_WEBHOOK=
# HONEY_POLL_MS=60000
