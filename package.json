{
  "name": "tripwire",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test -w server",
    "scan": "tsx server/cli/bin.ts scan",
    "build:cli": "node scripts/build-cli.mjs",
    "import:gitleaks": "tsx scripts/import-gitleaks.mts",
    "bench": "tsx bench/run.mts",
    "bench:fetch": "tsx bench/fetch-gitleaks.mts"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15"
  },
  "bin": {
    "tripwire": "action/tripwire.mjs"
  }
}
